rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isRoot() {
      return signedIn()
        && request.auth.token.email == "arielriquelme08@gmail.com";
    }

    function isOwner() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    function onlyInteractionFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(["likes", "comentarios", "guardadoPor"]);
    }

    function validUsername(username) {
      return username.matches('^[a-z0-9][a-z0-9._-]{2,31}$');
    }

    function ownsRequestedUsername() {
      return !request.resource.data.keys().hasAny(["username"])
        || (
          validUsername(request.resource.data.username)
          && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid
        );
    }

    match /users/{userId} {
      allow read: if true;

      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && ownsRequestedUsername();

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if true;

      allow create: if signedIn()
        && validUsername(username)
        && request.resource.data.uid == request.auth.uid;

      allow update: if signedIn()
        && validUsername(username)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /timelines/{timelineId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isRoot()
        || isOwner()
        || (signedIn() && onlyInteractionFieldsChanged());

      allow delete: if isRoot() || isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
